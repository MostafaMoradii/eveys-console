{
  "name": "@eveys-console/server",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "mint-token": "node scripts/mint-dev-token.mjs"
  },
  "dependencies": {
    "@eveys-console/api-types": "workspace:*",
    "@eveys-console/protocol": "workspace:*",
    "@fastify/jwt": "9.0.2",
    "@fastify/sensible": "6.0.2",
    "@fastify/websocket": "11.0.1",
    "fastify": "5.2.1",
    "kafkajs": "2.2.4",
    "pino": "9.5.0",
    "undici": "6.21.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "@types/ws": "8.5.13",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
